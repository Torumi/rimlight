# rimlight: let the logged-in user access the LED strip's hidraw nodes without root.
#
# Install:
#   sudo cp 99-rimlight.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then unplug and replug the strip.
#
# hidapi uses the hidraw backend on Linux, so only hidraw nodes need access.
# TAG+="uaccess" grants access to the active local session via systemd-logind ACLs.

KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37fa", ATTRS{idProduct}=="8202", TAG+="uaccess"
